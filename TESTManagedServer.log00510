         and t1.DOCUMENTGROUP='CLAIM'
         AND ( t1.USERID IN
                  (    SELECT   t2.USER_ID
                         FROM   user_detail t2
                   START WITH   UPPER (t2.USER_ID) = USER
                   CONNECT BY   PRIOR UPPER (t2.USER_ID) =
                                   UPPER (t2.manager_id)))> 
