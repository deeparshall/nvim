####<Oct 6, 2026 10:26:44,943 AM AST> <Notice> <Stdout> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '37' for queue: 'weblogic.kernel.Default (self-tuning)'> <May> <> <00jivooEHkWFw00Fzzw0w00004Zw000G^v> <1791271604943> <[severity-value: 32] [rid: 0:7] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <CHRT_ORIGINAL_QUERY :  select Loss_name colLossName, Reported_loss colReportedLoss
                from
                (select CATASTROPHE_CODE loss_code, b.CATASTROPHE_DESCRIPTION loss_name, sum(nvl(a.CLAIM_PAID_REP_CCY,0)+nvl(a.CLAIM_RESERVE_REP_CCY,0)) Reported_loss
                from inwards_monthly_claims a, CATASTROPHE b
                where  a.processing_year    = (select nvl(max(PROCESSING_YEAR),to_number(to_char(sysdate,'yyyy'))) from PROCESSING_PERIOD)
                and a.processing_month = 4
                and a.ACCUMULATION_CODE= b.CATASTROPHE_CODE
                group by CATASTROPHE_CODE, b.CATASTROPHE_DESCRIPTION
                order by 3 desc)
                where rownum <= 10> 
