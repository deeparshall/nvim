sPolicy.TERRORISM_INDICATOR,         InwardsPolicy.CLAIM_QUERY_IND,         InwardsPolicy.CLAIM_QUERY_REF,         InwardsPolicy.RISK_LOCATION_NUMBER,         InwardsPolicy.TECHNICAL_RATE,         InwardsPolicy.AVERAGE_OFFERED_RATE,         InwardsPolicy.RATE_ADEQUACY,         InwardsPolicy.RATE_BASIS,         InwardsPolicy.URC_REF,         InwardsPolicy.LIFE_CONTRACT_END_DATE,         InwardsPolicy.RATE_ADEQUACY_TREATY,         InwardsPolicy.CONTRACT_ABSOLUTE_NET,         InwardsPolicy.BOUQUET_ABSOLUTE_NET,         InwardsPolicy.COMMENTS_PRICING_REF,         InwardsPolicy.SETTLEMENT_CURRENCY_CODE,         InwardsPolicy.SETTLEMENT_CURRENCY_RATE,         InwardsPolicy.ULR,         InwardsPolicy.ACCEPTED_DATE_TIME_UPDATED,         InwardsPolicy.CONFIRM_DATE_TIME_UPDATED,         InwardsPolicy.CLOSED_DATE_TIME_UPDATED,         InwardsPolicy.CANCELLED_DATE_TIME_UPDATED,         InwardsPolicy.COMMUTED_DATE_TIME_UPDATED,         InwardsPolicy.ACCEPTED_UPDATE_BY,         InwardsPolicy.CONFIRM_UPDATE_BY,         InwardsPolicy.CLOSED_UPDATE_BY,         InwardsPolicy.CANCELLED_UPDATE_BY,         InwardsPolicy.COMMUTED_UPDATE_BY,         ((SELECT DISTINCT d.division_code FROM sub_profit_centre d WHERE d.location_code = InwardsPolicy.LOCATION_CODE and SUB_PROFIT_CENTRE_CODE = InwardsPolicy.SUB_PROFIT_CENTRE_CODE and rownum = 1)) AS DivisionCode,         ((select PROFIT_CENTRE_CODE from sub_profit_centre where SUB_PROFIT_CENTRE_CODE = InwardsPolicy.SUB_PROFIT_CENTRE_CODE and LOCATION_CODE = InwardsPolicy.LOCATION_CODE and rownum = 1)) AS ProfitCentreCode,         ((select broker_cedant_name from broker_cedant   where  broker_cedant_code =InwardsPolicy.BROKER_CODE and rownum = 1)) AS VIEW_ATTR,         ((select broker_cedant_name from broker_cedant   where  broker_cedant_code =InwardsPolicy.CEDANT_CODE and rownum = 1)) AS VIEW_ATTR,         ((select TYPE_OF_BUSINESS    from  TYPE_OF_BUSINESS    where  TYPE_OF_BUSINESS_CODE =InwardsPolicy.TYPE_OF_BUSINESS_CODE and rownum = 1)) AS VIEW_ATTR,         ((       select  SUB_PROFIT_CENTRE  from    SUB_PROFIT_CENTRE A,PROFIT_CENTRE B   where  A.SUB_PROFIT_CENTRE_CODE = InwardsPolicy.SUB_PROFIT_CENTRE_CODE   and    A.PROFIT_CENTRE_CODE = B.PROFIT_CENTRE_CODE   and    A.DIVISION_CODE = B.DIVISION_CODE   and    A.LOCATION_CODE = B.LOCATION_CODE   and    B.DIVISION_CODE != 'RI' and rownum = 1 )) AS SubProfitCenter,         ((select PROFIT_CENTRE  from    SUB_PROFIT_CENTRE A,PROFIT_CENTRE B   where  A.SUB_PROFIT_CENTRE_CODE = InwardsPolicy.SUB_PROFIT_CENTRE_CODE   and    A.PROFIT_CENTRE_CODE = B.PROFIT_CENTRE_CODE   and    A.DIVISION_CODE = B.DIVISION_CODE   and    A.LOCATION_CODE = B.LOCATION_CODE   and    B.DIVISION_CODE != 'RI' and rownum = 1)) AS ProfitCenter,         ((select region_description from region r where r.region_code = InwardsPolicy.RISK_REGION_CODE and rownum = 1)) AS REGION_DESCRIPTION,         ((select country_description from country a  where A.COUNTRY_CODE = InwardsPolicy.RISK_COUNTRY_CODE and rownum = 1)) AS COUNTRY_DESCRIPTION,         ((select description  from contract_status  where contract_status = InwardsPolicy.CONTRACT_STATUS and rownum = 1 )) AS CONTRACT_STATUS_DESC,         ((select lob_description from lob b where b.lob_code = InwardsPolicy.LOB_CODE)) AS lob_description,         ((SELECT division_name FROM division where division_code = (SELECT DISTINCT d.division_code FROM sub_profit_centre d WHERE d.location_code = InwardsPolicy.LOCATION_CODE and SUB_PROFIT_CENTRE_CODE = InwardsPolicy.SUB_PROFIT_CENTRE_CODE and rownum = 1))) AS division_name,         ((select b.BRANCH_NAME from BRANCH b where B.BRANCH_CODE = InwardsPolicy.BRANCH_CODE and b.BRANCH_GROUP_CODE = InwardsPolicy.BRANCH_GROUP_CODE)) AS BRANCH_NAME,         ((select lob_code||' - '||lob_description from lob b where b.lob_code = InwardsPolicy.LOB_CODE AND ROWNUM = 1)) AS VIEW_ATTR,         ((select broker_cedant_code||' - '|| broker_cedant_name from broker_cedant   where  broker_cedant_code =InwardsPolicy.BROKER_CODE and rownum = 1)) AS VIEW_ATTR,         ((select broker_cedant_code||' - '|| broker_cedant_name from broker_cedant   where  broker_cedant_code =InwardsPolicy.CEDANT_CODE and rownum = 1)) AS VIEW_ATTR,         ((select sub_profit_centre_code||' - '||sub_profit_centre from sub_profit_centre b where b.sub_profit_centre_code = InwardsPolicy.SUB_PROFIT_CENTRE_CODE AND ROWNUM = 1)) AS VIEW_ATTR,         ((select country_code||' - '||country_description from country  where country_code = InwardsPolicy.RISK_COUNTRY_CODE AND ROWNUM = 1)) AS VIEW_ATTR,         (t> 
####<Oct 6, 2026 10:19:51,573 AM AST> <Notice> <StdErr> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '25' for queue: 'weblogic.kernel.Default (self-tuning)'> <SNK> <> <00jivoR_TBfFw00Fzzw0w00004Zw000GIv> <1791271191573> <[severity-value: 32] [rid: 0:7] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <runc(DATE_TIME_CREATED)) AS CreateDate1,         (trunc(DATE_TIME_UPDATED)) AS UpdateDate1,         ((SELECT USER_ID||' - '||USERNAME FROM USER_DETAIL WHERE USER_ID=InwardsPolicy.USER_CREATED)) AS UserCreatedDesc,         ((SELECT USER_ID||' - '||USERNAME FROM USER_DETAIL WHERE USER_ID=InwardsPolicy.USER_UPDATED)) AS UserUpdatedDesc FROM INWARDS_POLICY InwardsPolicy WHERE ( ( (InwardsPolicy.SEQUENCE_NUMBER = :P_SEQUENCE_NO ) AND (UPPER(InwardsPolicy.CONTRACT_NUMBER) = UPPER(:P_CONTRACT_NO) ) AND (InwardsPolicy.UNDERWRITING_YEAR = :P_UNDERWITING_YEAR ) ) ) ORDER BY CONTRACT_NUMBER,UNDERWRITING_YEAR> 
