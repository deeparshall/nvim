####<Oct 6, 2026 10:27:00,240 AM AST> <Notice> <Stdout> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '10' for queue: 'weblogic.kernel.Default (self-tuning)'> <May> <> <00jivop8zGyFw00Fzzw0w00004Zw000Gc9> <1791271620240> <[severity-value: 32] [rid: 0:7] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <v_query : select rownum CHRT_NO,CHRT_ID,CHRT_NAME, CHRA_TYPE,CHRA_ORDER,CHRT_ORIGINAL_QUERY,CHRT_ACTIVE, CHRA_VISIBLE, CHRA_SHOW_TABLE, CHRA_WIDTH, CHRA_HEIGHT, CHRA_NEW_LINE, CHRA_PAGE_ID, CHRA_CUSTOM_QUERY, CHRA_AUTO_REFRESH from (   select T1.CHRT_ID,T1.CHRT_NAME,T2.CHRA_TYPE,   T2.CHRA_ORDER,t1.CHRT_ORIGINAL_QUERY,t1.CHRT_ACTIVE,   nvl(T2.CHRA_VISIBLE,'Y') CHRA_VISIBLE,  nvl(T2.CHRA_SHOW_TABLE,'X') CHRA_SHOW_TABLE,   nvl(t2.CHRA_WIDTH,0) CHRA_WIDTH, nvl(t2.CHRA_HEIGHT,0) CHRA_HEIGHT, nvl(t2.CHRA_NEW_LINE,'A') CHRA_NEW_LINE,   t2.CHRA_PAGE_ID, t2.CHRA_CUSTOM_QUERY, nvl(t2.CHRA_AUTO_REFRESH,0) CHRA_AUTO_REFRESH    from   DASHBOARD_CHART t1, DASHBOARD_ACCESS t2    where  T1.CHRT_ID=T2.CHRA_CHRT_ID    and T1.CHRT_ACTIVE='Y' and nvl(T2.CHRA_VISIBLE,'Y')='Y'    and (  (t2.CHRA_USER_ID='MAY'  and  t2.CHRA_USER_ID is not null)     or            (t2.CHRA_ROLE_ID in (select ROLE_ID from USER_DETAIL where USER_ID='MAY') and t2.CHRA_ROLE_ID is not null)      )  and  t2.CHRA_PAGE_ID=1359   order by T2.CHRA_ORDER )> 
####<Oct 6, 2026 10:27:00,256 AM AST> <Notice> <Stdout> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '10' for queue: 'weblogic.kernel.Default (self-tuning)'> <May> <> <00jivop8zGyFw00Fzzw0w00004Zw000Gc9> <1791271620256> <[severity-value: 32] [rid: 0:7] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <CHRT_ORIGINAL_QUERY : select *
  FROM   VW_RMS_DOCUMENTS t1
 WHERE   t1.DOCUMENTSTATUS NOT IN ('COM', 'ACT', 'CNL')
         AND ( t1.USERID IN
                  (    SELECT   t2.USER_ID
                         FROM   user_detail t2
                   START WITH   UPPER (t2.USER_ID) = USER
                   CONNECT BY   PRIOR UPPER (t2.USER_ID) =
                                   UPPER (t2.manager_id)))> 
####<Oct 6, 2026 10:27:00,256 AM AST> <Notice> <Stdout> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '10' for queue: 'weblogic.kernel.Default (self-tuning)'> <May> <> <00jivop8zGyFw00Fzzw0w00004Zw000Gc9> <1791271620256> <[severity-value: 32] [rid: 0:7] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <upd CHRT_ORIGINAL_QUERY : select *
