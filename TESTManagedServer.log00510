####<Oct 6, 2026 10:26:45,662 AM AST> <Notice> <Stdout> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '2' for queue: 'weblogic.kernel.Default (self-tuning)'> <May> <> <00jivooHGVzFw00Fzzw0w00004Zw000GaA> <1791271605662> <[severity-value: 32] [rid: 0:7] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <CHRT_ORIGINAL_QUERY : select Loss_name colLossName, Reported_loss colReportedLoss
            from
            (select a.claim_number loss_code, a.CLAIM_DESCRIPTION loss_name, sum(nvl(a.CLAIM_PAID_REP_CCY,0)+nvl(a.CLAIM_RESERVE_REP_CCY,0)) Reported_loss
            from inwards_monthly_claims a, inwards_policy b
            where  a.processing_year    = (select nvl(max(PROCESSING_YEAR),to_number(to_char(sysdate,'yyyy'))) from PROCESSING_PERIOD)
            and a.processing_month = 4
            and a.inwards_policy_sequence_no= b.sequence_number
            and b.underwriting_year    = (select nvl(max(PROCESSING_YEAR),to_number(to_char(sysdate,'yyyy'))) from PROCESSING_PERIOD)
            group by a.claim_number, a.CLAIM_DESCRIPTION
            order by 3 desc)
            where rownum <= 10> 
####<Oct 6, 2026 10:26:45,662 AM AST> <Notice> <Stdout> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '2' for queue: 'weblogic.kernel.Default (self-tuning)'> <May> <> <00jivooHGVzFw00Fzzw0w00004Zw000GaA> <1791271605662> <[severity-value: 32] [rid: 0:7] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <upd CHRT_ORIGINAL_QUERY : select Loss_name colLossName, Reported_loss colReportedLoss
            from
            (select a.claim_number loss_code, a.CLAIM_DESCRIPTION loss_name, sum(nvl(a.CLAIM_PAID_REP_CCY,0)+nvl(a.CLAIM_RESERVE_REP_CCY,0)) Reported_loss
            from inwards_monthly_claims a, inwards_policy b
            where  a.processing_year    = (select nvl(max(PROCESSING_YEAR),to_number(to_char(sysdate,'yyyy'))) from PROCESSING_PERIOD)
            and a.processing_month = 4
            and a.inwards_policy_sequence_no= b.sequence_number
            and b.underwriting_year    = (select nvl(max(PROCESSING_YEAR),to_number(to_char(sysdate,'yyyy'))) from PROCESSING_PERIOD)
            group by a.claim_number, a.CLAIM_DESCRIPTION
            order by 3 desc)
