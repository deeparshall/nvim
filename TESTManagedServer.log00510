  InwardsPolicy.INSURED_NAME,                          
  InwardsPolicy.INSURED_SHORT_NAME,                          
  InwardsPolicy.LOB_CODE,                          
  InwardsPolicy.BRANCH_GROUP_CODE,                          
  InwardsPolicy.BRANCH_CODE,                          
  InwardsPolicy.SUB_BRANCH_CODE,                          
  InwardsPolicy.TYPE_OF_BUSINESS_CODE,                          
  InwardsPolicy.RISK_REGION_CODE,                          
  InwardsPolicy.RISK_COUNTRY_CODE,                          
  InwardsPolicy.DOMICILE_REGION_CODE,                          
  InwardsPolicy.DOMICILE_COUNTRY_CODE,                          
  InwardsPolicy.ACCOUNT_HANDLER,                          
  InwardsPolicy.PROCESSING_TYPE,                          
  InwardsPolicy.OCCUPANCY_CODE,                          
  InwardsPolicy.CEDANT_BROKER_REF,                          
  InwardsPolicy.INCEPTION_DATE,                          
  InwardsPolicy.EXPIRY_DATE,                          
  InwardsPolicy.NEW_BUSINESS_IND,                          
  InwardsPolicy.SLIP_LEADER_CODE,                          
  InwardsPolicy.POLICY_CURRENCY,                          
  InwardsPolicy.SPECIAL_EXCHANGE_RATE,                          
  InwardsPolicy.SLIP_LEADER_PERCENTAGE,                          
  InwardsPolicy.NOTICE_OF_CANCELLATION,                          
  InwardsPolicy.NOTICE_OF_RENEWAL,                          
  InwardsPolicy.SHARE_WRITTEN,                          
  InwardsPolicy.SHARE_SIGNED,                          
  InwardsPolicy.LOC_APPLIES,                          
  InwardsPolicy.ACCOUNT_RENDERING_PERIOD,                          
  InwardsPolicy.PAYMENT_OF_ACC_PERIOD,                          
  InwardsPolicy.ORIGINAL_INSURED,                          
  InwardsPolicy.DATE_OF_OFFER_TELEX,                          
  InwardsPolicy.MAINTENANCE_PERIOD,                          
  InwardsPolicy.RENEWAL_OF_IPSN,                          
  InwardsPolicy.RENEWED_BY_IPSN,                          
  InwardsPolicy.ATTACHED_TO_IPSN,                          
  InwardsPolicy.CLEAN_CUT_IND,                          
  InwardsPolicy.BASIS_OF_INSURANCE,                          
  InwardsPolicy.PREM_PAYMENT_WARRANTY,                          
  InwardsPolicy.WORDING_STATUS,                          
  InwardsPolicy.WORDING_SIGNED_DATE,                          
  InwardsPolicy.MIN_DEP_INDICATOR,                          
  InwardsPolicy.FINAL_ADJ_IND,                          
  InwardsPolicy.ADJUSTMENT_DUE_DATE,                          
  InwardsPolicy.CEDANT_EPI,                          
  InwardsPolicy.WRITTEN_ORDER_PERCENT,                          
  InwardsPolicy.QUOTA_SHARE_CESSION,                          
  InwardsPolicy.SLIP_SIGNED_DATE,                          
  InwardsPolicy.UNDER_REPAIR_RATE,                          
  InwardsPolicy.NOT_UNDER_REPAIR_RATE,                          
  InwardsPolicy.LOC_REFERENCE,                          
  InwardsPolicy.PAYMENT_DUE,                          
  InwardsPolicy.ACCOUNTING_BROKER,                          
  InwardsPolicy.ARCHIVE_IND,                          
  InwardsPolicy.DATE_ACCEPTED,                          
  InwardsPolicy.DATE_CONFIRMED,                          
  InwardsPolicy.DATE_CLOSED,                          
  InwardsPolicy.DATE_CANCELLED,                          
  InwardsPolicy.FOLLOW_UP_PENDING,                          
  InwardsPolicy.CONTRACT_STATUS,                          
  InwardsPolicy.CATASTROPHE_COVER_IND,                          
  InwardsPolicy.RETAINED_PERCENTAGE,                          
  InwardsPolicy.LAST_BOOKED_TRANS_NO,                          
  InwardsPolicy.BROKER_CODE,                          
  InwardsPolicy.SUB_PROFIT_CENTRE_CODE,                          
  InwardsPolicy.CEDANT_CODE,                          
  InwardsPolicy.AGGREGATED_CLAIMS,                          
  InwardsPolicy.DATE_STATUS_CHANGED,                          
  InwardsPolicy.LATEST_PENDING_DATE,                          
  InwardsPolicy.SIGNED_ORDER_PERCENT,                          
  InwardsPolicy.INSURED_DOMICILE_REGION_CODE,                          
  InwardsPolicy.INSURED_DOMICILE_COUNTRY_CODE,                          
  InwardsPolicy.CLAIM_LEADER_CODE,                          
  InwardsPolicy.PREM_BORD_IND,                          
  InwardsPolicy.CLAIM_BORD_IND,                          
  InwardsPolicy.NEXT_INSTALMENT_SET_NUMBER,                          
  InwardsPolicy.PRODUCER_ACCOUNT_HANDLER,                          
  InwardsPolicy.CLOSING_REMINDER_PERIOD,                          
  InwardsPolicy.EXCLUSIONS_AND_CONDITIONS_REF,                          
  InwardsPolicy.PARTICULARS_REF,                          
  InwardsPolicy.ORDER_DETAILS_REF,                          
  InwardsPolicy.BOUQUET_DETAILS_REF,                          
  InwardsPolicy.COMMENTS_REF,                          
  InwardsPolicy.FINAL_ACCOUNT_INDICATOR,                          
  InwardsPolicy.CONTACT_REFERENCE,                          
  InwardsPolicy.PACKAGE_RATE,                          
  InwardsPolicy.LTA_DISCOUNT_RATE,                          
  InwardsPolicy.PPD_RATE,                          
  InwardsPolicy.PPD_DAYS,                          
  InwardsPolicy.PPD_BASIS,                          
  InwardsPolicy.NCB_PREM_BASE,                          
  InwardsPolicy.NCB_PREMIUM_BASIS,                          
  InwardsPolicy.NCB_RATE,                          
  InwardsPolicy.NCB_LOSS_RATIO,                          
  InwardsPolicy.VAT_CATEGORY,                          
  InwardsPolicy.VAT_CODE,                          
  InwardsPolicy.INITIAL_EPI_CURRENCY,                          
  InwardsPolicy.INITIAL_EPI_AMOUNT,                          
  InwardsPolicy.INITIAL_LIABILITY_CURRENCY,                          
  InwardsPolicy.INITIAL_LIABILITY_AMOUNT,                          
  InwardsPolicy.ULTIMATE_LOSS_RATIO,                          
  InwardsPolicy.PPW_BASIS,                          
  InwardsPolicy.DATE_TIME_CREATED,                          
  --InwardsPolicy.USER_CREATED,                          
  InwardsPolicy.DATE_TIME_UPDATED,                          
  InwardsPolicy.USER_UPDATED,                          
  InwardsPolicy.BUREAU_INDICATOR,                          
  InwardsPolicy.ESTIMATED_SHARE_SIGNED,                          
  InwardsPolicy.RENEWABLE_CONTRACT,                          
  InwardsPolicy.INTEREST_INSURED,                          
  InwardsPolicy.TERMS_OF_TRADE,                          
  InwardsPolicy.ACCOUNTING_PRODUCER,                          
  InwardsPolicy.RETROCESSION_IND,                          
  InwardsPolicy.COMMUTED_DATE,                          
  InwardsPolicy.MAJOR_LOSS_NO,                          
  InwardsPolicy.SHARE_EFFECTIVE_DATE,                          
  InwardsPolicy.URC_INDICATOR,                          
  InwardsPolicy.ACCEPTED_BY,                          
  InwardsPolicy.CONFIRMED_BY,                          
  InwardsPolicy.PROTECTION_PROGRAM_CODE,                          
  InwardsPolicy.CATASTROPHE_INDICATOR,                          
  InwardsPolicy.LIABILITY_PERILS,                          
  InwardsPolicy.URC_REASON,                          
  InwardsPolicy.COVER_TYPE,                          
  InwardsPolicy.POLICY_TOTAL_SUM_INSURED,                          
  InwardsPolicy.CEDANT_RETENTION,                          
  InwardsPolicy.JURISDICTION_REGION_CODE,                          
  InwardsPolicy.JURISDICTION_COUNTRY_CODE,                          
  InwardsPolicy.LAW_REGION_CODE,                          
  InwardsPolicy.LAW_COUNTRY_CODE,                          
  InwardsPolicy.CLAIM_HANDLING_CLAUSE,                          
  InwardsPolicy.SPECIAL_ACCEPTANCE_REF,                          
  InwardsPolicy.TERRORISM_INDICATOR,                          
  InwardsPolicy.CLAIM_QUERY_IND,                          
  InwardsPolicy.CLAIM_QUERY_REF,                          
  InwardsPolicy.RISK_LOCATION_NUMBER,                          
  InwardsPolicy.TECHNICAL_RATE,                          
  InwardsPolicy.AVERAGE_OFFERED_RATE,                          
  InwardsPolicy.RATE_ADEQUACY,                          
  InwardsPolicy.RATE_BASIS,                          
  InwardsPolicy.URC_REF,                          
  InwardsPolicy.LIFE_CONTRACT_END_DATE,                          
  InwardsPolicy.RATE_ADEQUACY_TREATY,                          
  InwardsPolicy.CONTRACT_ABSOLUTE_NET,                          
  InwardsPolicy.BOUQUET_ABSOLUTE_NET,                          
  InwardsPolicy.COMMENTS_PRICING_REF,                          
  InwardsPolicy.SETTLEMENT_CURRENCY_CODE,                          
  InwardsPolicy.SETTLEMENT_CURRENCY_RATE,                          
  InwardsPolicy.ULR,                          
  InwardsPolicy.ACCEPTED_DATE_TIME_UPDATED,                          
  InwardsPolicy.CONFIRM_DATE_TIME_UPDATED,                          
  InwardsPolicy.CLOSED_DATE_TIME_UPDATED,                          
  InwardsPolicy.CANCELLED_DATE_TIME_UPDATED,                          
  InwardsPolicy.COMMUTED_DATE_TIME_UPDATED,                          
  InwardsPolicy.ACCEPTED_UPDATE_BY,                          
  InwardsPolicy.CONFIRM_UPDATE_BY,                          
  InwardsPolicy.CLOSED_UPDATE_BY,                          
  InwardsPolicy.CANCELLED_UPDATE_BY,                          
  InwardsPolicy.COMMUTED_UPDATE_BY,                          
  ic.CLAIM_CURRENCY,                          
  ic.CLAIM_STATUS,> 
####<Oct 6, 2026 10:25:22,457 AM AST> <Notice> <StdErr> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '8' for queue: 'weblogic.kernel.Default (self-tuning)'> <FAR> <> <00jivojGHp3Fw00Fzzw0w00004Zw000GXo> <1791271522457> <[severity-value: 32] [rid: 0:5] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <ic.CLAIM_DESCRIPTION ,                          
  ic.ACCUMULATION_CODE,                          
  ic.date_time_created claimDate,                          
  (SELECT c.CEDANT_SHORT_NAME                          
  FROM BROKER_CEDANT c                          
  WHERE c.BROKER_CEDANT_CODE = InwardsPolicy.CEDANT_CODE                          
  AND rownum                 =1                          
  ) AS THE_CEDANT_NAME ,                          
  (SELECT a.LOCATION_REPORTING_CURRENCY                          
  FROM LOCATION a                          
  WHERE a.LOCATION_CODE = InwardsPolicy.LOCATION_CODE                          
  AND rownum            =1                          
  ) AS THE_REP_CCY,                          
  (SELECT a.ACCUMULATION_LIMIT_REP_CCY                          
  FROM LOCATION a                          
  WHERE a.LOCATION_CODE = InwardsPolicy.LOCATION_CODE                          
  AND rownum            =1                          
  ) AS ACCUMULATION_LIMIT,                          
  nvl2(                          
  (SELECT INWARDS_POLICY_SEQUENCE_NO                          
  FROM POLICY_RETROCESSION                          
  WHERE POLICY_RETROCESSION.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER                          
  AND rownum                                           =1                          
  ) , 'Y' , 'N' ) AS THE_MANUAL_IND,                          
  nvl2(                          
  (SELECT INWARDS_POLICY_SEQUENCE_NO                          
  FROM POLICY_RETROCESSION                          
  WHERE POLICY_RETROCESSION.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER                          
  AND rownum                                           =1                          
  ) , 'Yes' , 'No' ) AS THE_RETRO_EXIST,                          
  ( 
  SELECT LIABILITY_CURRENCY FROM ( SELECT IPL.LIABILITY_CURRENCY FROM INWARDS_POLICY_LIABILITY IPL    
    WHERE IPL.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER ORDER BY IPL.DATE_TIME_CREATED ) WHERE ROWNUM = 1  
  ) AS LIABILITY_CURRENCY,  
(SELECT   currency_code || ' - ' || currency_description FROM currency where currency_code = (       
         SELECT LIABILITY_CURRENCY FROM ( SELECT IPL.LIABILITY_CURRENCY FROM INWARDS_POLICY_LIABILITY IPL    
    WHERE IPL.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER ORDER BY IPL.DATE_TIME_CREATED ) WHERE ROWNUM = 1                     
                            
  ) and rownum = 1) AS LIABILITY_CURRENCY_DESCRIPTION,   
  (SELECT NVL(MAX_LIABILITY,0)                          
  FROM INWARDS_POLICY_LIABILITY                          
  WHERE INWARDS_POLICY_LIABILITY.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER                          
  AND rownum                                                =1                          
  ) AS THE_MAX_LIABILITY,                          
  (SELECT BROKER_CEDANT_NAME                          
  FROM BROKER_CEDANT                          
  WHERE BROKER_CEDANT.BROKER_CEDANT_CODE = InwardsPolicy.ACCOUNTING_PRODUCER                          
  AND rownum                             =1                          
  ) AS THE_ACCOUNTING_PRODUCER_NAME,                          
  (SELECT PROFIT_CENTRE_CODE                          
  FROM SUB_PROFIT_CENTRE                          
  WHERE SUB_PROFIT_CENTRE.SUB_PROFIT_CENTRE_CODE = InwardsPolicy.SUB_PROFIT_CENTRE_CODE                          
  AND rownum                                     =1                          
  ) AS THE_PC_CODE,                          
  (SELECT CASH_LOSS_LIMIT                          
  FROM INWARDS_PRO_RATA_POLICY                          
  WHERE INWARDS_PRO_RATA_POLICY.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER                          
  AND rownum                                               =1                          
  ) AS THE_CASH_LOSS_LIMIT ,                          
  (SELECT SUM(NVL(CLAIM_PORTFOLIO_IN,0))                          
  FROM INWARDS_PRO_RATA_ACCT_TRAN                          
  WHERE INWARDS_PRO_RATA_ACCT_TRAN.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER                          
                        
  ) AS THE_CLAIM_PORTFOLIO_IN,                          
  (SELECT A.BRANCH_NAME                          
  FROM BRANCH A,                          
    SUB_BRANCH B                          
  WHERE A.BRANCH_GROUP_CODE = InwardsPolicy.BRANCH_GROUP_CODE                          
  AND A.BRANCH_CODE         = InwardsPolicy.BRANCH_CODE                          
  AND B.SUB_BRANCH_CODE     = InwardsPolicy.SUB_BRANCH_CODE                          
  AND B.BRANCH_GROUP_CODE   = A.BRANCH_GROUP_CODE                          
  AND B.BRANCH_CODE         = A.BRANCH_CODE                          
  AND rownum                =1                          
  ) AS THE_BRANCH_NAME,                          
  (SELECT B.SUB_BRANCH_NAME                          
  FROM BRANCH A,                          
    SUB_BRANCH B                          
  WHERE A.BRANCH_GROUP_CODE = InwardsPolicy.BRANCH_GROUP_CODE                          
  AND A.BRANCH_CODE         = InwardsPolicy.BRANCH_CODE                          
  AND B.SUB_BRANCH_CODE     = InwardsPolicy.SUB_BRANCH_CODE                          
  AND B.BRANCH_GROUP_CODE   = A.BRANCH_GROUP_CODE                          
  AND B.BRANCH_CODE         = A.BRANCH_CODE                          
  AND rownum                =1                          
  ) AS THE_SUB_BRANCH_NAME ,                          
  (SELECT COUNT(*)                          
  FROM INWARDS_POLICY_LINKAGE                          
  WHERE INWARDS_POLICY_LINKAGE.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER                          
  AND rownum                                              = 1                          
  ) AS THE_LINKAGE_COUNT ,                          
  (SELECT COUNT(*)                          
  FROM POLICY_VESSEL_AIRCRAFT_DETAIL A                          
  WHERE A.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER                          
  ) AS VESSEL_AIRCRAFT_DETAIL_Count ,                          
  ic.LOSS_DATE ,                          
  ic.CEDANT_BROKER_CLAIM_REF ,                          
  ic.INITIAL_LOSS_ESTIMATE ,                          
  ic.CAUSE_OF_CLAIM ,                          
  ic.CLAIM_HANDLER ,                          
  ic.CLAIM_REGION ,                          
  ic.CLAIM_COUNTRY ,                          
  (SELECT SUB_PROFIT_CENTRE_CODE                          
    || ' - '                          
    || SUB_PROFIT_CENTRE                          
  FROM SUB_PROFIT_CENTRE                          
  WHERE SUB_PROFIT_CENTRE_CODE = InwardsPolicy.SUB_PROFIT_CENTRE_CODE                          
  AND rownum                   = 1                          
  ) SPC ,                          
  (SELECT LOB_CODE                          
    || ' - '                          
    || LOB_DESCRIPTION                          
  FROM lob                          
  WHERE LOB_CODE = InwardsPolicy.LOB_CODE                          
  AND rownum     = 1                          
  ) AS LOB ,                          
  (SELECT BROKER_CEDANT_CODE                          
    || ' - '                          
    || BROKER_CEDANT_NAME                          
  FROM BROKER_CEDANT BrokerCedant                          
  WHERE BROKER_CEDANT_CODE = InwardsPolicy.CEDANT_CODE                          
  AND rownum               = 1                          
  ) AS Cedant ,              
   (SELECT a.CURRENCY_CODE || ' - ' ||  A.CURRENCY_DESCRIPTION                     
  FROM CURRENCY a                        
  WHERE a.CURRENCY_CODE = ic.CLAIM_CURRENCY                      
  AND rownum            =1                        
 ) AS CLAIM_CURRENCY_DESC,              
 (SELECT a.CURRENCY_CODE || ' - ' ||  A.CURRENCY_DESCRIPTION                      
  FROM CURRENCY a                        
  WHERE a.CURRENCY_CODE = InwardsPolicy.INITIAL_LIABILITY_CURRENCY              
  AND rownum            =1                        
 ) AS LIBALITY_CURRENCY_DESC,              
 (SELECT a.CURRENCY_CODE || ' - ' ||  A.CURRENCY_DESCRIPTION                      
  FROM CURRENCY a                        
  WHERE a.CURRENCY_CODE = (SELECT a.LOCATION_REPORTING_CURRENCY                        
  FROM LOCATION a                        
  WHERE a.LOCATION_CODE = InwardsPolicy.LOCATION_CODE                        
  AND rownum            =1                        
  )                        
  AND rownum            =1                        
 ) AS REPORTING_CURRENCY_DESC,              
  (SELECT BROKER_CEDANT_CODE                          
    || ' - '                          
    || BROKER_CEDANT_NAME                          
  FROM BROKER_CEDANT BrokerCedant                          
  WHERE BROKER_CEDANT_CODE = InwardsPolicy.BROKER_CODE                          
  AND rownum               = 1                          
  ) AS Broker  ,                        
  (SELECT LOOKUP_CODE                                             
    || ' - '                                             
    || LOOKUP_DESC                                              
  FROM RMS_LOOKUP A                                             
  WHERE A.LOOKUP_TYPE='PROCESSING_TYPE'                                             
  AND A.LOOKUP_CODE  = InwardsPolicy.PROCESSING_TYPE                                             
  ) AS PROCESSING_TYPE_DESC,                                             
  (SELECT LOOKUP_CODE                                             
    || ' - '                                             
    || LOOKUP_DESC                                              
  FROM RMS_LOOKUP A                                             
  WHERE A.LOOKUP_TYPE='PORTFOLIO_TYPE'                                             
  AND A.LOOKUP_CODE  = InwardsPolicy.PORTFOLIO_TYPE                                             
  ) AS PORTFOLIO_TYPE_DESC,                                             
  (SELECT LOOKUP_CODE> 
####<Oct 6, 2026 10:25:22,457 AM AST> <Notice> <StdErr> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '8' for queue: 'weblogic.kernel.Default (self-tuning)'> <FAR> <> <00jivojGHp3Fw00Fzzw0w00004Zw000GXo> <1791271522457> <[severity-value: 32] [rid: 0:5] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <|| ' - '                                             
    || LOOKUP_DESC                                              
  FROM RMS_LOOKUP A                                             
  WHERE A.LOOKUP_TYPE='TYPE_OF_CONTRACT'                                             
  AND A.LOOKUP_CODE  = InwardsPolicy.TYPE_OF_CONTRACT                                             
  ) AS TYPE_OF_CONTRACT_DESC,                                             
  (SELECT TYPE_OF_BUSINESS_CODE                                             
    || ' - '                                             
    || TYPE_OF_BUSINESS                                              
  FROM TYPE_OF_BUSINESS A                                             
  WHERE A.TYPE_OF_BUSINESS_CODE = InwardsPolicy.TYPE_OF_BUSINESS_CODE                                             
  ) AS TYPE_OF_BUSINESS_DESC,                                             
  (SELECT CLAIM_STATUS                                             
    || ' - '                                             
    || DESCRIPTION                                              
  FROM claim_status A                                             
  WHERE A.CLAIM_STATUS = ic.CLAIM_STATUS                                           
  )AS CLAIM_STATUS_DESC  ,                 
  (SELECT a.LOCATION_CODE || ' - ' ||  A.LOCATION_NAME                        
  FROM LOCATION a                          
  WHERE a.LOCATION_CODE = InwardsPolicy.LOCATION_CODE                          
  AND rownum            =1                          
 ) AS LOCATION,                
  (SELECT B.SUB_BRANCH_CODE || ' - ' || B.SUB_BRANCH_NAME                                     
  FROM BRANCH A,                                     
    SUB_BRANCH B                                     
  WHERE A.BRANCH_GROUP_CODE = InwardsPolicy.BRANCH_GROUP_CODE                                     
  AND A.BRANCH_CODE         = InwardsPolicy.BRANCH_CODE                                     
  AND B.SUB_BRANCH_CODE     = InwardsPolicy.SUB_BRANCH_CODE                                     
  AND B.BRANCH_GROUP_CODE   = A.BRANCH_GROUP_CODE                                     
  AND B.BRANCH_CODE         = A.BRANCH_CODE                                     
  AND rownum                =1                                     
  ) AS SUB_BRANCH  ,                    
  (select CONTRACT_STATUS || ' - ' ||DESCRIPTION from CONTRACT_STATUS where                                             
                         CONTRACT_STATUS = InwardsPolicy.CONTRACT_STATUS and rownum = 1) as Contract  ,                  
                         (SELECT   currency_code || ' - ' || currency_description FROM currency where                                     
                         currency_code = ic.CLAIM_CURRENCY and rownum = 1) as Currency,                              
                                          
                         (select CATASTROPHE_CODE || ' - ' || CATASTROPHE_DESCRIPTION   from   CATASTROPHE   where                            
                         CATASTROPHE_CODE =ic.ACCUMULATION_CODE and rownum = 1)  as Accumulation    ,            
                         ( select    broker_cedant_code || ' - ' || broker_cedant_name  from broker_cedant                
   WHERE BROKER_CEDANT_TYPE IN ('C','B') and broker_cedant_code =  InwardsPolicy.ACCOUNTING_PRODUCER          AND ROWNUM = 1) Accounting_Producer_Name ,       
   trunc(InwardsPolicy.DATE_TIME_CREATED) DATE_CREATED,       
   trunc(InwardsPolicy.DATE_TIME_UPDATED) DATE_UPDATED,      
       (SELECT CASH_LOSS_CURRENCY                           
  FROM INWARDS_PRO_RATA_POLICY                           
  WHERE INWARDS_PRO_RATA_POLICY.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER                           
                          
  ) AS CASH_LOSS_CURRENCY,     
     (SELECT   currency_code || ' - ' || currency_description FROM currency where                                     
                         currency_code = (     
         SELECT CASH_LOSS_CURRENCY                           
  FROM INWARDS_PRO_RATA_POLICY                           
  WHERE INWARDS_PRO_RATA_POLICY.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER                           
                          
  ) and rownum = 1)     
                          AS CASH_LOSS_CURRENCY_DESC,    
(SELECT LOSS_CAP                           
  FROM INWARDS_POLICY_LIABILITY                           
  WHERE INWARDS_POLICY_LIABILITY.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER and rownum = 1                           
                          
  ) AS LOSS_CAP    
FROM INWARDS_POLICY InwardsPolicy,                          
  inwards_claim ic                          
WHERE InwardsPolicy.SEQUENCE_NUMBER=INWARDS_POLICY_SEQUENCE_NO(+)                          
AND InwardsPolicy.SEQUENCE_NUMBER  = NVL(:pSeqNum , InwardsPolicy.SEQUENCE_NUMBER)                          
AND (ic.CLAIM_NUMBER               = NVL(:pClaimNum , ic.CLAIM_NUMBER)                          
OR ic.CLAIM_NUMBER                IS NULL)) QRSLT  WHERE (1=1  and 1=1 and PROCESSING_TYPE  = 0 and SUB_PROFIT_CENTRE_CODE in (select SUB_PROFIT_CENTRE_CODE from USER_SUB_PROFIT_CENTRE where LOCATION_CODE ='01' and USER_ID ='FAR')) AND ( ( ( (CLAIM_NUMBER = :P_CLAIM_NO ) ) ) ) ORDER BY date_time_created desc> 
