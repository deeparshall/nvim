####<Oct 6, 2026 10:27:58,158 AM AST> <Notice> <StdErr> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '32' for queue: 'weblogic.kernel.Default (self-tuning)'> <May> <> <00jivosYU2^Fw00Fzzw0w00004Zw000Gf7> <1791271678158> <[severity-value: 32] [rid: 0:3] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <query : SELECT /*+ FIRST_ROWS(20) */ RmsDocumentsDetails.DOCUMENT_SEQUENCE_NUMBER,         RmsDocumentsDetails.ITEM_NO,         RmsDocumentsDetails.VALUE_CODE,         RmsDocumentsDetails.DATE_TIME_CREATED,         RmsDocumentsDetails.USER_CREATED,         RmsDocumentsDetails.DATE_TIME_UPDATED,         RmsDocumentsDetails.USER_UPDATED,         RmsDocumentsDetails.DISPLAY_ORDER,         RmsDocumentsDetails.NUMBER_VALUE,         RmsDocumentsDetails.VALUE_CODE AS VALUE_CODE1,         (trunc(DATE_TIME_CREATED)) AS CreateDate1,         (trunc(DATE_TIME_UPDATED)) AS UpdateDate1 FROM RMS_DOCUMENTS_DETAILS RmsDocumentsDetails WHERE (DOCUMENT_SEQUENCE_NUMBER='885651'  and ITEM_NO IN( SELECT /*+ FULL(A)*/ ITEM_NO FROM DOCUMENT_ITEMS A WHERE A.DOCUMENT_TYPE = '70' AND A.DISPLAYED = 'T')) AND (:Bind_DocumentSequenceNumber = DOCUMENT_SEQUENCE_NUMBER) ORDER BY RmsDocumentsDetails.DISPLAY_ORDER> 
