####<Oct 6, 2026 10:26:45,662 AM AST> <Notice> <Stdout> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '2' for queue: 'weblogic.kernel.Default (self-tuning)'> <May> <> <00jivooHGVzFw00Fzzw0w00004Zw000GaA> <1791271605662> <[severity-value: 32] [rid: 0:7] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <CHRT_ORIGINAL_QUERY :         select *
        from
        (select b.underwriting_year colUwyear, count(a.claim_number) colCounter
        from inwards_claim a,  inwards_policy b
        where  b.underwriting_year >= (select nvl(max(PROCESSING_YEAR)-10,to_number(to_char(sysdate,'yyyy'))) from PROCESSING_PERIOD)
        and a.claim_status in ('3','4','G')
        and a.inwards_policy_sequence_no= b.sequence_number
        group by b.underwriting_year
        order by 1 desc)> 
####<Oct 6, 2026 10:26:45,662 AM AST> <Notice> <Stdout> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '2' for queue: 'weblogic.kernel.Default (self-tuning)'> <May> <> <00jivooHGVzFw00Fzzw0w00004Zw000GaA> <1791271605662> <[severity-value: 32] [rid: 0:7] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <upd CHRT_ORIGINAL_QUERY :         select *
        from
        (select b.underwriting_year colUwyear, count(a.claim_number) colCounter
        from inwards_claim a,  inwards_policy b
        where  b.underwriting_year >= (select nvl(max(PROCESSING_YEAR)-10,to_number(to_char(sysdate,'yyyy'))) from PROCESSING_PERIOD)
        and a.claim_status in ('3','4','G')
        and a.inwards_policy_sequence_no= b.sequence_number
        group by b.underwriting_year
        order by 1 desc)> 
####<Oct 6, 2026 10:26:45,662 AM AST> <Notice> <Stdout> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '2' for queue: 'weblogic.kernel.Default (self-tuning)'> <May> <> <00jivooHGVzFw00Fzzw0w00004Zw000GaA> <1791271605662> <[severity-value: 32] [rid: 0:7] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <CHRT_ORIGINAL_QUERY : select t1.colGroup, nvl(sum(decode(t1.colGroup,'New',t2.sumnew,'Open',t2.sumopen,'Closed',t2.sumclosed,0)),0) colCounter,
       decode(t1.colGroup,'New',1,'Open',2,'Closed',3,0) colSort
from
(select 'New' colGroup from dual union select 'Open' colGroup from dual union select 'Closed' colGroup from dual) t1,
(select sum (a.new) sumnew, sum(c.open) sumopen, sum (d.closed) sumclosed
from inwards_policy b,
    (select a.inwards_policy_sequence_no, count(*) New
     from inwards_claim a
     where a.claim_status = '6'
     and a.user_created = user
     group by a.inwards_policy_sequence_no) a,
    (select a.inwards_policy_sequence_no, count(*) open
     from inwards_claim a
     where a.claim_status not in ('3','4','G')
     and a.user_created = user
     group by a.inwards_policy_sequence_no) c,
    (select a.inwards_policy_sequence_no, count(*) closed
     from inwards_claim a
     where a.claim_status in ('6','3','4','G')
     and a.user_created = user
     group by a.inwards_policy_sequence_no) d
where  b.underwriting_year >= (select nvl(max(PROCESSING_YEAR)-10,to_number(to_char(sysdate,'yyyy'))) from PROCESSING_PERIOD)
and a.inwards_policy_sequence_no(+)= b.sequence_number
and c.inwards_policy_sequence_no(+)= b.sequence_number
and d.inwards_policy_sequence_no(+)= b.sequence_number
) t2
group by t1.colGroup> 
####<Oct 6, 2026 10:26:45,662 AM AST> <Notice> <Stdout> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '2' for queue: 'weblogic.kernel.Default (self-tuning)'> <May> <> <00jivooHGVzFw00Fzzw0w00004Zw000GaA> <1791271605662> <[severity-value: 32] [rid: 0:7] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <upd CHRT_ORIGINAL_QUERY : select t1.colGroup, nvl(sum(decode(t1.colGroup,'New',t2.sumnew,'Open',t2.sumopen,'Closed',t2.sumclosed,0)),0) colCounter,
       decode(t1.colGroup,'New',1,'Open',2,'Closed',3,0) colSort
from
(select 'New' colGroup from dual union select 'Open' colGroup from dual union select 'Closed' colGroup from dual) t1,
(select sum (a.new) sumnew, sum(c.open) sumopen, sum (d.closed) sumclosed
from inwards_policy b,
    (select a.inwards_policy_sequence_no, count(*) New
     from inwards_claim a
     where a.claim_status = '6'
     and a.user_created = user
     group by a.inwards_policy_sequence_no) a,
    (select a.inwards_policy_sequence_no, count(*) open
     from inwards_claim a
     where a.claim_status not in ('3','4','G')
     and a.user_created = user
     group by a.inwards_policy_sequence_no) c,
    (select a.inwards_policy_sequence_no, count(*) closed
     from inwards_claim a
     where a.claim_status in ('6','3','4','G')
     and a.user_created = user
     group by a.inwards_policy_sequence_no) d
where  b.underwriting_year >= (select nvl(max(PROCESSING_YEAR)-10,to_number(to_char(sysdate,'yyyy'))) from PROCESSING_PERIOD)
and a.inwards_policy_sequence_no(+)= b.sequence_number
and c.inwards_policy_sequence_no(+)= b.sequence_number
and d.inwards_policy_sequence_no(+)= b.sequence_number
) t2
group by t1.colGroup> 
