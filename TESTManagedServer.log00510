####<Oct 6, 2026 10:27:53,033 AM AST> <Notice> <Stdout> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '34' for queue: 'weblogic.kernel.Default (self-tuning)'> <May> <> <00jivosIGRUFw00Fzzw0w00004Zw000Gf4> <1791271673033> <[severity-value: 32] [rid: 0:7] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <CHRT_ORIGINAL_QUERY : select   t1.*,
         (select nvl(max(EMAIL_ADDRESS),'') from user_detail where USER_ID = t1.ASSIGNED_TO) AssignToUseridEmail,
         (select nvl(max(EMAIL_ADDRESS),'') from user_detail where USER_ID = t1.OWNER_ID) OwnerUseridEmail
  FROM   VW_RMS_TASKS t1
 WHERE   t1.TASK_ID is not null
         AND t1.TASK_STATUS_ID  IN (1,2,3) 
         AND T1.ASSIGNED_TO = USER> 
