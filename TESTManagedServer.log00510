  InwardsPolicy.CONFIRM_UPDATE_BY,                          
  InwardsPolicy.CLOSED_UPDATE_BY,                          
  InwardsPolicy.CANCELLED_UPDATE_BY,                          
  InwardsPolicy.COMMUTED_UPDATE_BY,                          
  ic.CLAIM_CURRENCY,                          
  ic.CLAIM_STATUS,> 
####<Oct 6, 2026 10:22:38,848 AM AST> <Notice> <StdErr> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '2' for queue: 'weblogic.kernel.Default (self-tuning)'> <FAR> <> <00jivo_VnTeFw00Fzzw0w00004Zw000GTM> <1791271358848> <[severity-value: 32] [rid: 0:5] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <ic.CLAIM_DESCRIPTION ,                          
  ic.ACCUMULATION_CODE,                          
  ic.date_time_created claimDate,                          
  (SELECT c.CEDANT_SHORT_NAME                          
  FROM BROKER_CEDANT c                          
  WHERE c.BROKER_CEDANT_CODE = InwardsPolicy.CEDANT_CODE                          
  AND rownum                 =1                          
  ) AS THE_CEDANT_NAME ,                          
  (SELECT a.LOCATION_REPORTING_CURRENCY                          
  FROM LOCATION a                          
  WHERE a.LOCATION_CODE = InwardsPolicy.LOCATION_CODE                          
  AND rownum            =1                          
  ) AS THE_REP_CCY,                          
  (SELECT a.ACCUMULATION_LIMIT_REP_CCY                          
  FROM LOCATION a                          
  WHERE a.LOCATION_CODE = InwardsPolicy.LOCATION_CODE                          
  AND rownum            =1                          
  ) AS ACCUMULATION_LIMIT,                          
  nvl2(                          
  (SELECT INWARDS_POLICY_SEQUENCE_NO                          
  FROM POLICY_RETROCESSION                          
  WHERE POLICY_RETROCESSION.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER                          
  AND rownum                                           =1                          
  ) , 'Y' , 'N' ) AS THE_MANUAL_IND,                          
  nvl2(                          
  (SELECT INWARDS_POLICY_SEQUENCE_NO                          
  FROM POLICY_RETROCESSION                          
  WHERE POLICY_RETROCESSION.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER                          
  AND rownum                                           =1                          
  ) , 'Yes' , 'No' ) AS THE_RETRO_EXIST,                          
  ( 
  SELECT LIABILITY_CURRENCY FROM ( SELECT IPL.LIABILITY_CURRENCY FROM INWARDS_POLICY_LIABILITY IPL    
    WHERE IPL.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER ORDER BY IPL.DATE_TIME_CREATED ) WHERE ROWNUM = 1  
  ) AS LIABILITY_CURRENCY,  
(SELECT   currency_code || ' - ' || currency_description FROM currency where currency_code = (       
         SELECT LIABILITY_CURRENCY FROM ( SELECT IPL.LIABILITY_CURRENCY FROM INWARDS_POLICY_LIABILITY IPL    
    WHERE IPL.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER ORDER BY IPL.DATE_TIME_CREATED ) WHERE ROWNUM = 1                     
                            
  ) and rownum = 1) AS LIABILITY_CURRENCY_DESCRIPTION,   
  (SELECT NVL(MAX_LIABILITY,0)                          
  FROM INWARDS_POLICY_LIABILITY                          
  WHERE INWARDS_POLICY_LIABILITY.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER                          
  AND rownum                                                =1                          
  ) AS THE_MAX_LIABILITY,                          
  (SELECT BROKER_CEDANT_NAME                          
  FROM BROKER_CEDANT                          
  WHERE BROKER_CEDANT.BROKER_CEDANT_CODE = InwardsPolicy.ACCOUNTING_PRODUCER                          
  AND rownum                             =1                          
  ) AS THE_ACCOUNTING_PRODUCER_NAME,                          
  (SELECT PROFIT_CENTRE_CODE                          
  FROM SUB_PROFIT_CENTRE                          
  WHERE SUB_PROFIT_CENTRE.SUB_PROFIT_CENTRE_CODE = InwardsPolicy.SUB_PROFIT_CENTRE_CODE                          
  AND rownum                                     =1                          
  ) AS THE_PC_CODE,                          
  (SELECT CASH_LOSS_LIMIT                          
  FROM INWARDS_PRO_RATA_POLICY                          
  WHERE INWARDS_PRO_RATA_POLICY.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER                          
  AND rownum                                               =1                          
  ) AS THE_CASH_LOSS_LIMIT ,                          
  (SELECT SUM(NVL(CLAIM_PORTFOLIO_IN,0))                          
  FROM INWARDS_PRO_RATA_ACCT_TRAN                          
  WHERE INWARDS_PRO_RATA_ACCT_TRAN.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER                          
                        
  ) AS THE_CLAIM_PORTFOLIO_IN,                          
  (SELECT A.BRANCH_NAME                          
  FROM BRANCH A,                          
    SUB_BRANCH B                          
  WHERE A.BRANCH_GROUP_CODE = InwardsPolicy.BRANCH_GROUP_CODE                          
  AND A.BRANCH_CODE         = InwardsPolicy.BRANCH_CODE                          
  AND B.SUB_BRANCH_CODE     = InwardsPolicy.SUB_BRANCH_CODE                          
  AND B.BRANCH_GROUP_CODE   = A.BRANCH_GROUP_CODE                          
  AND B.BRANCH_CODE         = A.BRANCH_CODE                          
  AND rownum                =1                          
  ) AS THE_BRANCH_NAME,                          
  (SELECT B.SUB_BRANCH_NAME                          
  FROM BRANCH A,                          
    SUB_BRANCH B                          
  WHERE A.BRANCH_GROUP_CODE = InwardsPolicy.BRANCH_GROUP_CODE                          
  AND A.BRANCH_CODE         = InwardsPolicy.BRANCH_CODE                          
  AND B.SUB_BRANCH_CODE     = InwardsPolicy.SUB_BRANCH_CODE                          
  AND B.BRANCH_GROUP_CODE   = A.BRANCH_GROUP_CODE                          
  AND B.BRANCH_CODE         = A.BRANCH_CODE                          
  AND rownum                =1                          
  ) AS THE_SUB_BRANCH_NAME ,                          
  (SELECT COUNT(*)                          
  FROM INWARDS_POLICY_LINKAGE                          
  WHERE INWARDS_POLICY_LINKAGE.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER                          
  AND rownum                                              = 1                          
  ) AS THE_LINKAGE_COUNT ,                          
  (SELECT COUNT(*)                          
  FROM POLICY_VESSEL_AIRCRAFT_DETAIL A                          
  WHERE A.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER                          
  ) AS VESSEL_AIRCRAFT_DETAIL_Count ,                          
  ic.LOSS_DATE ,                          
  ic.CEDANT_BROKER_CLAIM_REF ,                          
  ic.INITIAL_LOSS_ESTIMATE ,                          
  ic.CAUSE_OF_CLAIM ,                          
  ic.CLAIM_HANDLER ,                          
  ic.CLAIM_REGION ,                          
  ic.CLAIM_COUNTRY ,                          
  (SELECT SUB_PROFIT_CENTRE_CODE                          
    || ' - '                          
    || SUB_PROFIT_CENTRE                          
  FROM SUB_PROFIT_CENTRE                          
  WHERE SUB_PROFIT_CENTRE_CODE = InwardsPolicy.SUB_PROFIT_CENTRE_CODE                          
  AND rownum                   = 1                          
  ) SPC ,                          
  (SELECT LOB_CODE                          
    || ' - '                          
    || LOB_DESCRIPTION                          
  FROM lob                          
  WHERE LOB_CODE = InwardsPolicy.LOB_CODE                          
  AND rownum     = 1                          
  ) AS LOB ,                          
  (SELECT BROKER_CEDANT_CODE                          
    || ' - '                          
    || BROKER_CEDANT_NAME                          
  FROM BROKER_CEDANT BrokerCedant                          
  WHERE BROKER_CEDANT_CODE = InwardsPolicy.CEDANT_CODE                          
  AND rownum               = 1                          
  ) AS Cedant ,              
   (SELECT a.CURRENCY_CODE || ' - ' ||  A.CURRENCY_DESCRIPTION                     
  FROM CURRENCY a                        
  WHERE a.CURRENCY_CODE = ic.CLAIM_CURRENCY                      
  AND rownum            =1                        
 ) AS CLAIM_CURRENCY_DESC,              
 (SELECT a.CURRENCY_CODE || ' - ' ||  A.CURRENCY_DESCRIPTION                      
  FROM CURRENCY a                        
  WHERE a.CURRENCY_CODE = InwardsPolicy.INITIAL_LIABILITY_CURRENCY              
  AND rownum            =1                        
 ) AS LIBALITY_CURRENCY_DESC,              
 (SELECT a.CURRENCY_CODE || ' - ' ||  A.CURRENCY_DESCRIPTION                      
  FROM CURRENCY a                        
  WHERE a.CURRENCY_CODE = (SELECT a.LOCATION_REPORTING_CURRENCY                        
  FROM LOCATION a                        
  WHERE a.LOCATION_CODE = InwardsPolicy.LOCATION_CODE                        
  AND rownum            =1                        
  )                        
  AND rownum            =1                        
 ) AS REPORTING_CURRENCY_DESC,              
  (SELECT BROKER_CEDANT_CODE                          
    || ' - '                          
    || BROKER_CEDANT_NAME                          
  FROM BROKER_CEDANT BrokerCedant                          
  WHERE BROKER_CEDANT_CODE = InwardsPolicy.BROKER_CODE                          
  AND rownum               = 1                          
  ) AS Broker  ,                        
  (SELECT LOOKUP_CODE                                             
    || ' - '                                             
    || LOOKUP_DESC                                              
  FROM RMS_LOOKUP A                                             
  WHERE A.LOOKUP_TYPE='PROCESSING_TYPE'                                             
  AND A.LOOKUP_CODE  = InwardsPolicy.PROCESSING_TYPE                                             
  ) AS PROCESSING_TYPE_DESC,                                             
  (SELECT LOOKUP_CODE                                             
    || ' - '                                             
    || LOOKUP_DESC                                              
  FROM RMS_LOOKUP A                                             
  WHERE A.LOOKUP_TYPE='PORTFOLIO_TYPE'                                             
  AND A.LOOKUP_CODE  = InwardsPolicy.PORTFOLIO_TYPE                                             
  ) AS PORTFOLIO_TYPE_DESC,                                             
  (SELECT LOOKUP_CODE> 
####<Oct 6, 2026 10:22:38,848 AM AST> <Notice> <StdErr> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '2' for queue: 'weblogic.kernel.Default (self-tuning)'> <FAR> <> <00jivo_VnTeFw00Fzzw0w00004Zw000GTM> <1791271358848> <[severity-value: 32] [rid: 0:5] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <|| ' - '                                             
    || LOOKUP_DESC                                              
  FROM RMS_LOOKUP A                                             
  WHERE A.LOOKUP_TYPE='TYPE_OF_CONTRACT'                                             
  AND A.LOOKUP_CODE  = InwardsPolicy.TYPE_OF_CONTRACT                                             
  ) AS TYPE_OF_CONTRACT_DESC,                                             
  (SELECT TYPE_OF_BUSINESS_CODE                                             
    || ' - '                                             
    || TYPE_OF_BUSINESS                                              
  FROM TYPE_OF_BUSINESS A                                             
  WHERE A.TYPE_OF_BUSINESS_CODE = InwardsPolicy.TYPE_OF_BUSINESS_CODE                                             
  ) AS TYPE_OF_BUSINESS_DESC,                                             
  (SELECT CLAIM_STATUS                                             
    || ' - '                                             
    || DESCRIPTION                                              
  FROM claim_status A                                             
  WHERE A.CLAIM_STATUS = ic.CLAIM_STATUS                                           
  )AS CLAIM_STATUS_DESC  ,                 
  (SELECT a.LOCATION_CODE || ' - ' ||  A.LOCATION_NAME                        
  FROM LOCATION a                          
  WHERE a.LOCATION_CODE = InwardsPolicy.LOCATION_CODE                          
  AND rownum            =1                          
 ) AS LOCATION,                
  (SELECT B.SUB_BRANCH_CODE || ' - ' || B.SUB_BRANCH_NAME                                     
  FROM BRANCH A,                                     
    SUB_BRANCH B                                     
  WHERE A.BRANCH_GROUP_CODE = InwardsPolicy.BRANCH_GROUP_CODE                                     
  AND A.BRANCH_CODE         = InwardsPolicy.BRANCH_CODE                                     
  AND B.SUB_BRANCH_CODE     = InwardsPolicy.SUB_BRANCH_CODE                                     
  AND B.BRANCH_GROUP_CODE   = A.BRANCH_GROUP_CODE                                     
  AND B.BRANCH_CODE         = A.BRANCH_CODE                                     
  AND rownum                =1                                     
  ) AS SUB_BRANCH  ,                    
  (select CONTRACT_STATUS || ' - ' ||DESCRIPTION from CONTRACT_STATUS where                                             
                         CONTRACT_STATUS = InwardsPolicy.CONTRACT_STATUS and rownum = 1) as Contract  ,                  
                         (SELECT   currency_code || ' - ' || currency_description FROM currency where                                     
                         currency_code = ic.CLAIM_CURRENCY and rownum = 1) as Currency,                              
                                          
                         (select CATASTROPHE_CODE || ' - ' || CATASTROPHE_DESCRIPTION   from   CATASTROPHE   where                            
                         CATASTROPHE_CODE =ic.ACCUMULATION_CODE and rownum = 1)  as Accumulation    ,            
                         ( select    broker_cedant_code || ' - ' || broker_cedant_name  from broker_cedant                
   WHERE BROKER_CEDANT_TYPE IN ('C','B') and broker_cedant_code =  InwardsPolicy.ACCOUNTING_PRODUCER          AND ROWNUM = 1) Accounting_Producer_Name ,       
   trunc(InwardsPolicy.DATE_TIME_CREATED) DATE_CREATED,       
   trunc(InwardsPolicy.DATE_TIME_UPDATED) DATE_UPDATED,      
       (SELECT CASH_LOSS_CURRENCY                           
  FROM INWARDS_PRO_RATA_POLICY                           
  WHERE INWARDS_PRO_RATA_POLICY.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER                           
                          
  ) AS CASH_LOSS_CURRENCY,     
     (SELECT   currency_code || ' - ' || currency_description FROM currency where                                     
                         currency_code = (     
         SELECT CASH_LOSS_CURRENCY                           
  FROM INWARDS_PRO_RATA_POLICY                           
  WHERE INWARDS_PRO_RATA_POLICY.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER                           
                          
  ) and rownum = 1)     
                          AS CASH_LOSS_CURRENCY_DESC,    
(SELECT LOSS_CAP                           
  FROM INWARDS_POLICY_LIABILITY                           
  WHERE INWARDS_POLICY_LIABILITY.INWARDS_POLICY_SEQUENCE_NO = InwardsPolicy.SEQUENCE_NUMBER and rownum = 1                           
                          
  ) AS LOSS_CAP    
FROM INWARDS_POLICY InwardsPolicy,                          
  inwards_claim ic                          
WHERE InwardsPolicy.SEQUENCE_NUMBER=INWARDS_POLICY_SEQUENCE_NO(+)                          
AND InwardsPolicy.SEQUENCE_NUMBER  = NVL(:pSeqNum , InwardsPolicy.SEQUENCE_NUMBER)                          
AND (ic.CLAIM_NUMBER               = NVL(:pClaimNum , ic.CLAIM_NUMBER)                          
OR ic.CLAIM_NUMBER                IS NULL)) QRSLT  WHERE (1=1  and 1=1 and PROCESSING_TYPE  = 0 and SUB_PROFIT_CENTRE_CODE in (select SUB_PROFIT_CENTRE_CODE from USER_SUB_PROFIT_CENTRE where LOCATION_CODE ='01' and USER_ID ='FAR')) AND ( ( ( (CLAIM_NUMBER = :P_CLAIM_NO ) ) ) ) ORDER BY date_time_created desc> 
