####<Oct 6, 2026 10:37:32,553 AM AST> <Notice> <StdErr> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '11' for queue: 'weblogic.kernel.Default (self-tuning)'> <May> <> <00jivpQp4ZkFw00Fzzw0w00004Zw000H1g> <1791272252553> <[severity-value: 32] [rid: 0:3] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <--vo.getQuery()-2:SELECT RmsDocumentsImages.IMAGE_SEQ_NO,         RmsDocumentsImages.FILE_NAME,         RmsDocumentsImages.FILE_TITLE,         RmsDocumentsImages.IMAGE_FOLDER_CODE,         RmsDocumentsImages.POLICY_SEQUENCE_NO,         RmsDocumentsImages.CLAIM_NUMBER,         RmsDocumentsImages.BOOKED_TRANS_NO,         RmsDocumentsImages.DTS_NO,         RmsDocumentsImages.INSTALLMENT_SET_NO,         RmsDocumentsImages.SETTLEMENT_NO,         RmsDocumentsImages.DEPARTMENT_ID,         RmsDocumentsImages.RMS_TYPE,         RmsDocumentsImages.COMMENTS,         RmsDocumentsImages.USER_CREATED,         RmsDocumentsImages.DATE_TIME_CREATED,         RmsDocumentsImages.USER_UPDATED,         RmsDocumentsImages.DATE_TIME_UPDATED,         RmsDocumentsImages.RECIEPT_NO,         RmsDocumentsImages.DOCUMENT_LOG_NUMBER,         RmsDocumentsImages.EXTENSION,         RmsDocumentsImages.SENDERDOMAIN,         RmsDocumentsImages.PARENT_KEY,         RmsDocumentsImages.BROKER_CEDANT_CODE,         RmsDocumentsImages.SCHEME_NUMBER,         RmsDocumentsImages.MEMBER_NUMBER,         RmsDocumentsImages.CONFIDENTIAL,         RmsDocumentsImages.PORTAL_REQUEST_NUMBER,         RmsDocumentsImages.SECTION_NUMBER,         RmsDocumentsImages.PARENT_KEY_COPY,         (SELECT  DESCRIPTION   FROM    IMAGE_TYPE    WHERE   IMAGE_FOLDER_CODE  = RmsDocumentsImages.IMAGE_FOLDER_CODE) AS IMAGE_TYPE_DESC,         trunc(RmsDocumentsImages.DATE_TIME_CREATED) AS DATE_CREATED FROM RMS_DOCUMENTS_IMAGES RmsDocumentsImages WHERE ((DEPARTMENT_ID = :controDEPARTMENT or :controDEPARTMENT is null)     and  parent_key is null) AND ((((nvl(POLICY_SEQUENCE_NO,0)          = DECODE('UNKNOWN', 'UNKNOWN', 0, 'UNKNOWN')
                               AND  NVL(CLAIM_NUMBER,0)                        = 0) or 
                               (nvl(POLICY_SEQUENCE_NO, 0)     = DECODE('UNKNOWN', 'UNKNOWN', 0, 'UNKNOWN')
  AND NVL(BOOKED_TRANS_NO,0)              = 0) or
                               (nvl(POLICY_SEQUENCE_NO, 0)     = DECODE('UNKNOWN', 'UNKNOWN', 0, 'UNKNOWN')
                               AND     NVL(INSTALLMENT_SET_NO,0)       = 0)or
                               (nvl(POLICY_SEQUENCE_NO, 0)     = DECODE('UNKNOWN', 'UNKNOWN', 0, 'UNKNOWN')
                               AND     NVL(SCHEME_NUMBER,0)                    = 0))
               OR      SETTLEMENT_NO                           = null
               OR      DTS_NO                                                  = 886309
               OR      RECIEPT_NO                                      = null
                       OR      DOCUMENT_LOG_NUMBER     = null
                       OR      SCHEME_NUMBER                   = null
                       OR      MEMBER_NUMBER                           =null
                       OR      BROKER_CEDANT_CODE      = 'null')
       AND             DEPARTMENT_ID                                           =  '11' 
       AND             PARENT_KEY                                                      IS NULL)> 
