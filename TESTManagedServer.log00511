####<Oct 6, 2026 10:37:55,246 AM AST> <Notice> <StdErr> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '22' for queue: 'weblogic.kernel.Default (self-tuning)'> <May> <> <00jivpSBgf7Fw00Fzzw0w00004Zw000H2Z> <1791272275246> <[severity-value: 32] [rid: 0:3] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <---sql-C3:  SELECT   DISTINCT
               A.IMAGE_FOLDER_CODE, COUNT (A.IMAGE_FOLDER_CODE) GROUP_COUNT
        FROM   RMS_DOCUMENTS_IMAGES A
       WHERE       A.POLICY_SEQUENCE_NO IS NULL
               AND A.CLAIM_NUMBER IS NULL
               AND A.BOOKED_TRANS_NO IS NULL
               AND A.INSTALLMENT_SET_NO IS NULL
               AND A.SETTLEMENT_NO IS NULL
               AND A.DTS_NO IS NULL
               AND A.RECIEPT_NO IS NULL
               AND A.DOCUMENT_LOG_NUMBER IS NULL
               AND A.SCHEME_NUMBER IS NULL
               AND A.MEMBER_NUMBER IS NULL
               AND A.SECTION_NUMBER IS NULL
               AND A.BROKER_CEDANT_CODE IS NULL
               AND A.DEPARTMENT_ID =  '11' 
               AND A.PARENT_KEY IS NULL
    GROUP BY   A.IMAGE_FOLDER_CODE
    ORDER BY   A.IMAGE_FOLDER_CODE> 
