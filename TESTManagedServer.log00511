####<Oct 6, 2026 10:37:17,741 AM AST> <Notice> <StdErr> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '27' for queue: 'weblogic.kernel.Default (self-tuning)'> <May> <> <00jivpPwKw7Fw00Fzzw0w00004Zw000Gzn> <1791272237741> <[severity-value: 32] [rid: 0:3] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <query : SELECT /*+ FIRST_ROWS(10) */ RmsDocuments.DOCUMENT_SEQUENCE_NUMBER,         RmsDocuments.DOCUMENT_STATUS,         RmsDocuments.DATE_SECTIONED,         RmsDocuments.ORDER_OF_IMPORTANCE,         RmsDocuments.DOCUMENT_TYPE,         RmsDocuments.DEADLINE_DATE,         RmsDocuments.ALLOCATED_TO,         RmsDocuments.DATE_ALLOCATED,         RmsDocuments.QUERY_DATE,         RmsDocuments.COMPLETED_DATE,         RmsDocuments.ACTIONED_DATE,         RmsDocuments.ORIGINAL_DOCUMENT_NUMBER,         RmsDocuments.COMMENTS_REF,         RmsDocuments.MEMO_NUMBER,         RmsDocuments.DATE_TIME_CREATED,         RmsDocuments.USER_CREATED,         RmsDocuments.DATE_TIME_UPDATED,         RmsDocuments.USER_UPDATED,         RmsDocuments.NO_OF_SUB_DOCUMENTS_NUMBER,         RmsDocuments.DOCUMENT_INDICATOR,         RmsDocuments.TRANSFERRED_FROM,         RmsDocuments.TRANSFERRED_DATE,         RmsDocuments.POLICY_SEQUENCE_NO,         RmsDocuments.CLAIM_NUMBER,         RmsDocuments.INSTALMENT_SET_NUMBER,         RmsDocuments.BROKER_CODE,         RmsDocuments.CEDANT_CODE,         RmsDocuments.CEDANT_BROKER_REF,         RmsDocuments.DATE_OF_LOSS,         RmsDocuments.ACCOUNT_TYPE,         RmsDocuments.CONTRACT_NUMBER,         RmsDocuments.UNDERWRITING_YEAR,         RmsDocuments.INCEPTION_DATE,         RmsDocuments.DOCUMENT_AMOUNT_REP_CCY,         RmsDocuments.REASON_FOR_CANCELLATION,         RmsDocuments.CANCELLATION_COMMENTS,         RmsDocuments.CANCELLATION_DATE,         RmsDocuments.DUPLICATED_DOCUMENT_NUMBER,         RmsDocuments.PORTAL_REQUEST_NUMBER,         (SELECT description         || ' ('         || DECODE (DOCUMENT_TYPE_INDICATOR,                    '1', (SELECT VALUE_DESCRIPTION                            FROM RMS_LOOKUP_VIEW                           WHERE LOOKUP_ID = 37 AND values_id = 129),                    '2', (SELECT VALUE_DESCRIPTION                            FROM RMS_LOOKUP_VIEW                           WHERE LOOKUP_ID = 37 AND values_id = 130),                    '3', (SELECT VALUE_DESCRIPTION                            FROM RMS_LOOKUP_VIEW                           WHERE LOOKUP_ID = 37 AND values_id = 131),                    '4', (SELECT VALUE_DESCRIPTION                            FROM RMS_LOOKUP_VIEW                           WHERE LOOKUP_ID = 37 AND values_id = 181))         || ')'    DESCRIPTION    FROM DOCUMENT_TYPE   WHERE DOCUMENT_TYPE = RmsDocuments.DOCUMENT_TYPE) AS Document_Type_Description,         (select a.value_code from rms_documents_details a ,  document_items b          where a.document_sequence_number =  nvl(RmsDocuments.DOCUMENT_SEQUENCE_NUMBER, 0)          and a.item_no = b.item_no and b.item_name = 'DOCUMENT_CURRENCY'          and rownum = 1) AS DocumentCurrency,         (select number_value from rms_documents_details  where document_sequence_number = nvl( RmsDocuments.DOCUMENT_SEQUENCE_NUMBER, 0)       and item_no in ( select item_no from document_items where item_name = 'DOCUMENT_AMOUNT' )      and rownum = 1) AS DocumentAmount,         ( select  DESCRIPTION  from   DOCUMENT_TYPE   where  DOCUMENT_TYPE = RmsDocuments.DOCUMENT_TYPE and rownum = 1) AS DESCRIPTION,         ( select  DESCRIPTION   from   INWARDS_DOCUMENT_STATUS   where   DOCUMENT_STATUS = RmsDocuments.DOCUMENT_STATUS and rownum = 1) AS DESCRIPTIONDOCSTATUS,         ( SELECT BROKER_CEDANT_NAME FROM   BROKER_CEDANT WHERE BROKER_CEDANT_CODE = RmsDocuments.BROKER_CODE  and broker_cedant_type = 'B' and rownum = 1) AS BROKER_CEDANT_NAME,         ( SELECT BROKER_CEDANT_NAME FROM   BROKER_CEDANT WHERE BROKER_CEDANT_CODE = RmsDocuments.CEDANT_CODE  and broker_cedant_type = 'C' and rownum = 1) AS CEDANT_CODE_NAME,         (select a.rms_document_type from document_type a where a.document_type =RmsDocuments.DOCUMENT_TYPE) AS rms_document_type,         RmsDocuments.DOCUMENT_TYPE AS DOCUMENT_TYPE1,         RmsDocuments.DOCUMENT_STATUS AS DOCUMENT_STATUS1,         RmsDocuments.ALLOCATED_TO AS ALLOCATED_TO1,         RmsDocuments.DOCUMENT_TYPE AS DOCUMENT_TYPE2,         RmsDocuments.DOCUMENT_STATUS AS DOCUMENT_STATUS2,         RmsDocuments.ALLOCATED_TO AS ALLOCATED_TO2,         RmsDocuments.ROWID,         RmsDocuments.BROKER_CODE AS BROKER_CODE1,         RmsDocuments.CEDANT_CODE AS CEDANT_CODE1,         trunc(DATE_TIME_CREATED) AS CreateDate1,         trunc(DATE_TIME_UPDATED) AS UpdateDate1,         trunc(RmsDocuments.DATE_SECTIONED) AS DATE_SECTIONED1,         trunc(RmsDocuments.DATE_ALLOCATED) AS DateAllocated1,         (SELECT VALUE_DESCRIPTION FROM RMS_LOOKUP_VIEW WHERE LOOKUP_ID=35 AND REFERNCE_ID=RmsDocuments.ORDER_OF_IMPORTANCE) AS VIEW_ATTR,         (select  NVL(DOCUMENT_STATUS || ' - ' || DESCRIPTION,'') from   INWARDS_DOCUMENT_STATUS where   DOCUMENT_STATUS = RmsDocuments.DOCUMENT_STATUS) AS DOC_STATUS_CODE_DESC,         (select  NVL(USER_ID || ' - ' || USERNAME,'') from USER_DETAIL where USER_ID = RmsDocuments.ALLOCATED_TO) AS ALLOCATED_TO_ID_DESC,         (SELECT BROKER_CEDANT_CODE || ' - ' || BROKER_CEDANT_NAME FROM BROKER_CEDANT WHERE BROKER_CEDANT_CODE = RmsDocuments.BROKER_CODE AND BROKER_CEDANT_TYPE = 'B') AS BROKER_CODE_DESC,         (SELECT BROKER_CEDANT_CODE || ' - ' || BROKER_CEDANT_NAME FROM BROKER_CEDANT WHERE BROKER_CEDANT_CODE = RmsDocuments.CEDANT_CODE AND BROKER_CEDANT_TYPE = 'C') AS CEDANT_CODE_DESC,         (SELECT DOCUMENT_TYPE || ' - ' || DESCRIPTION from DOCUMENT_TYPE where DOCUMENT_TYPE =RmsDocuments.DOCUMENT_TYPE) AS DOCUMENT_TYPE_DESC,         RmsDocuments.DOCUMENT_SUB_STATUS,         RmsDocuments.CLIENT_TYPE_OTHER,         (SELECT LISTAGG(           d.DOCUMENT_SUB_STATUS_CODE || ' - ' ||d.DOCUMENT_SUB_STATUS ,',') WITHIN GROUP (ORDER BY d.DOCUMENT_SUB_STATUS_CODE)  FROM DOCUMENT_SUB_STATUS d, RMS_LOOKUP_VIEW r,(         SELECT TO_NUMBER( REGEXP_SUBSTR(RmsDocuments.DOCUMENT_SUB_STATUS, '[^,]+', 1, LEVEL)) AS status_code         FROM dual         CONNECT BY REGEXP_SUBSTR(RmsDocuments.DOCUMENT_SUB_STATUS, '[^,]+',1,LEVEL ) IS NOT NULL       ) t  WHERE d.DOCUMENT_SUB_STATUS_CODE = t.status_code    AND d.PROCESS_TYPE = r.REFERNCE_ID AND r.LOOKUP_ID = 15) AS DocumentSubStatusCodeDesc,         (SELECT LISTAGG(d.DOCUMENT_SUB_STATUS, ',') WITHIN GROUP (ORDER BY d.DOCUMENT_SUB_STATUS_CODE)      FROM DOCUMENT_SUB_STATUS d,(SELECT TO_NUMBER(token) AS status_code         FROM (SELECT TRIM(REGEXP_SUBSTR(RmsDocuments.DOCUMENT_SUB_STATUS,'[^,]+',1,LEVEL)) AS token               FROM dual               CONNECT BY REGEXP_SUBSTR(RmsDocuments.DOCUMENT_SUB_STATUS,'[^,]+',1,LEVEL) IS NOT NULL)         WHERE REGEXP_LIKE(token, '^\d+$') ) t  WHERE d.DOCUMENT_SUB_STATUS_CODE = t.status_code ) AS DocumentSubStatusDesc,         RmsDocuments.SCOPE_ID,         RmsDocuments.SLA_ID,         (SELECT /*+ ORDERED */ ST.DESCRIPTION FROM SLA_SCOPE SS,SLA_TYPE ST WHERE SS.SLA_ID = ST.SLA_ID AND SS.SCOPE_ID = RmsDocuments.SCOPE_ID) AS SCOPE_DESCRIPTION,         (CASE WHEN RmsDocuments.SLA_ID IS NOT NULL THEN DTS_CHARTS.GET_ROW_RANGE_COLOR(DTS_CHARTS.CALCULATE_CONSUMED_PERCENTAGE((CASE WHEN RmsDocuments.DOCUMENT_TYPE = 35 THEN COALESCE ( (SELECT TO_DATE(A.VALUE_CODE) FROM RMS_DOCUMENTS_DETAILS A, DOCUMENT_ITEMS B WHERE B.DOCUMENT_TYPE = '35' AND A.ITEM_NO = B.ITEM_NO AND B.ITEM_NO = 1490 AND A.DOCUMENT_SEQUENCE_NUMBER = RmsDocuments.DOCUMENT_SEQUENCE_NUMBER), RmsDocuments.DATE_SECTIONED, RmsDocuments.DATE_TIME_CREATED) ELSE COALESCE (RmsDocuments.DATE_SECTIONED, RmsDocuments.DATE_TIME_CREATED) END), NVL (RmsDocuments.COMPLETED_DATE, SYSDATE),  NULL, (SELECT PROCESSING_DAYS FROM SLA_SCOPE SS, SLA_TYPE ST WHERE SS.SLA_ID = ST.SLA_ID AND SS.SCOPE_ID = RmsDocuments.SCOPE_ID)), NVL2(RmsDocuments.COMPLETED_DATE,'Y','N'))  END) AS SLA_RANGE_COLOR FROM RMS_DOCUMENTS RmsDocuments WHERE (ALLOCATED_TO = 'MAY' AND DOCUMENT_TYPE IN (SELECT DOCUMENT_TYPE FROM DOCUMENT_TYPE_ROLE WHERE ROLE_ID = 'CCA_2' and WRITE_IND =  'Y') and DOCUMENT_STATUS not in('CNL' ,'COM')) ORDER BY DOCUMENT_SEQUENCE_NUMBER DESC> 
