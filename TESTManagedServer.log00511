rdsPolicy.COMMENTS_REF,         InwardsPolicy.FINAL_ACCOUNT_INDICATOR,         InwardsPolicy.CONTACT_REFERENCE,         InwardsPolicy.PACKAGE_RATE,         InwardsPolicy.LTA_DISCOUNT_RATE,         InwardsPolicy.PPD_RATE,         InwardsPolicy.PPD_DAYS,         InwardsPolicy.PPD_BASIS,         InwardsPolicy.NCB_PREM_BASE,         InwardsPolicy.NCB_PREMIUM_BASIS,         InwardsPolicy.NCB_RATE,         InwardsPolicy.NCB_LOSS_RATIO,         InwardsPolicy.VAT_CATEGORY,         InwardsPolicy.VAT_CODE,         InwardsPolicy.INITIAL_EPI_CURRENCY,         InwardsPolicy.INITIAL_EPI_AMOUNT,         InwardsPolicy.INITIAL_LIABILITY_CURRENCY,         InwardsPolicy.INITIAL_LIABILITY_AMOUNT,         InwardsPolicy.ULTIMATE_LOSS_RATIO,         InwardsPolicy.PPW_BASIS,         InwardsPolicy.DATE_TIME_CREATED,         InwardsPolicy.USER_CREATED,         InwardsPolicy.DATE_TIME_UPDATED,         InwardsPolicy.USER_UPDATED,         InwardsPolicy.BUREAU_INDICATOR,         InwardsPolicy.ESTIMATED_SHARE_SIGNED,         InwardsPolicy.RENEWABLE_CONTRACT,         InwardsPolicy.INTEREST_INSURED,         InwardsPolicy.TERMS_OF_TRADE,         InwardsPolicy.ACCOUNTING_PRODUCER,         InwardsPolicy.RETROCESSION_IND,         InwardsPolicy.COMMUTED_DATE,         InwardsPolicy.MAJOR_LOSS_NO,         InwardsPolicy.SHARE_EFFECTIVE_DATE,         InwardsPolicy.URC_INDICATOR,         InwardsPolicy.ACCEPTED_BY,         InwardsPolicy.CONFIRMED_BY,         InwardsPolicy.PROTECTION_PROGRAM_CODE,         InwardsPolicy.CATASTROPHE_INDICATOR,         InwardsPolicy.LIABILITY_PERILS,         InwardsPolicy.URC_REASON,         InwardsPolicy.COVER_TYPE,         InwardsPolicy.POLICY_TOTAL_SUM_INSURED,         InwardsPolicy.CEDANT_RETENTION,         InwardsPolicy.JURISDICTION_REGION_CODE,         InwardsPolicy.JURISDICTION_COUNTRY_CODE,         InwardsPolicy.LAW_REGION_CODE,         InwardsPolicy.LAW_COUNTRY_CODE,         InwardsPolicy.CLAIM_HANDLING_CLAUSE,         InwardsPolicy.SPECIAL_ACCEPTANCE_REF,         InwardsPolicy.TERRORISM_INDICATOR,         InwardsPolicy.CLAIM_QUERY_IND,         InwardsPolicy.CLAIM_QUERY_REF,         InwardsPolicy.RISK_LOCATION_NUMBER,         InwardsPolicy.TECHNICAL_RATE,         InwardsPolicy.AVERAGE_OFFERED_RATE,         InwardsPolicy.RATE_ADEQUACY,         InwardsPolicy.RATE_BASIS,         InwardsPolicy.URC_REF,         InwardsPolicy.LIFE_CONTRACT_END_DATE,         InwardsPolicy.RATE_ADEQUACY_TREATY,         InwardsPolicy.CONTRACT_ABSOLUTE_NET,         InwardsPolicy.BOUQUET_ABSOLUTE_NET,         InwardsPolicy.COMMENTS_PRICING_REF,         InwardsPolicy.SETTLEMENT_CURRENCY_CODE,         InwardsPolicy.SETTLEMENT_CURRENCY_RATE,         InwardsPolicy.ULR,         InwardsPolicy.ACCEPTED_DATE_TIME_UPDATED,         InwardsPolicy.CONFIRM_DATE_TIME_UPDATED,         InwardsPolicy.CLOSED_DATE_TIME_UPDATED,         InwardsPolicy.CANCELLED_DATE_TIME_UPDATED,         InwardsPolicy.COMMUTED_DATE_TIME_UPDATED,         InwardsPolicy.ACCEPTED_UPDATE_BY,         InwardsPolicy.CONFIRM_UPDATE_BY,         InwardsPolicy.CLOSED_UPDATE_BY,         InwardsPolicy.CANCELLED_UPDATE_BY,         InwardsPolicy.COMMUTED_UPDATE_BY,         ((SELECT DISTINCT d.division_code FROM sub_profit_centre d WHERE d.location_code = InwardsPolicy.LOCATION_CODE and SUB_PROFIT_CENTRE_CODE = InwardsPolicy.SUB_PROFIT_CENTRE_CODE and rownum = 1)) AS DivisionCode,         ((select PROFIT_CENTRE_CODE from sub_profit_centre where SUB_PROFIT_CENTRE_CODE = InwardsPolicy.SUB_PROFIT_CENTRE_CODE and LOCATION_CODE = InwardsPolicy.LOCATION_CODE and rownum = 1)) AS ProfitCentreCode,         ((select broker_cedant_name from broker_cedant   where  broker_cedant_code =InwardsPolicy.BROKER_CODE and rownum = 1)) AS VIEW_ATTR,         ((select broker_cedant_name from broker_cedant   where  broker_cedant_code =InwardsPolicy.CEDANT_CODE and rownum = 1)) AS VIEW_ATTR,         ((select TYPE_OF_BUSINESS    from  TYPE_OF_BUSINESS    where  TYPE_OF_BUSINESS_CODE =InwardsPolicy.TYPE_OF_BUSINESS_CODE and rownum = 1)) AS VIEW_ATTR,         ((       select  SUB_PROFIT_CENTRE  from    SUB_PROFIT_CENTRE A,PROFIT_CENTRE B   where  A.SUB_PROFIT_CENTRE_CODE = InwardsPolicy.SUB_PROFIT_CENTRE_CODE   and    A.PROFIT_CENTRE_CODE = B.PROFIT_CENTRE_CODE   and    A.DIVISION_CODE = B.DIVISION_CODE   and    A.LOCATION_CODE = B.LOCATION_CODE   and    B.DIVISION_CODE != 'RI' and rownum = 1 )) AS SubProfitCenter,         ((select PROFIT_CENTRE  from    SUB_PROFIT_CENTRE A,PROFIT_CENTRE B   where  A.SUB_PROFIT_CENTRE_CODE = InwardsPolicy.SUB_PROFIT_CENTRE_CODE   and    A.PROFIT_CENTRE_CODE = B.PROFIT_CENTRE_CODE   and    A.DIVISION_CODE = B.DIVISION_CODE   and    A.LOCATION_CODE = B.LOCATION_CODE   and    B.DIVISION_CODE != 'RI' and rownum = 1)) AS ProfitCenter,         ((select region_description from region r where r.region_code = InwardsPolicy.RISK_REGION_CODE and rownum = 1)) AS REGION_DESCRIPTION,         ((select country_description from country a  where A.COUNTRY_CODE = InwardsPolicy.RISK_COUNTRY_CODE and rownum = 1)) AS COUNTRY_DESCRIPTION,         ((select description  from contract_status  where contract_status = InwardsPolicy.CONTRACT_STATUS and rownum = 1 )) AS CONTRACT_STATUS_DESC,         ((select lob_description from lob b where b.lob_code = InwardsPolicy.LOB_CODE)) AS lob_description,         ((SELECT division_name FROM division where division_code = (SELECT DISTINCT d.division_code FROM sub_profit_centre d WHERE d.location_code = InwardsPolicy.LOCATION_CODE and SUB_PROFIT_CENTRE_CODE = InwardsPolicy.SUB_PROFIT_CENTRE_CODE and rownum = 1))) AS division_name,         ((select b.BRANCH_NAME from BRANCH b where B.BRANCH_CODE = InwardsPolicy.BRANCH_CODE and b.BRANCH_GROUP_CODE = InwardsPolicy.BRANCH_GROUP_CODE)) AS BRANCH_NAME,         ((select lob_code||' - '||lob_description from lob b where b.lob_code = InwardsPolicy.LOB_CODE AND ROWNUM = 1)) AS VIEW_ATTR,         ((select broker_cedant_code||' - '|| broker_cedant_name from broker_cedant   where  broker_cedant_code =InwardsPolicy.BROKER_CODE and rownum = 1)) AS VIEW_ATTR,         ((select broker_cedant_code||' - '|| broker_cedant_name from broker_cedant   where  broker_cedant_code =InwardsPolicy.CEDANT_CODE and rownum = 1)) AS VIEW_ATTR,         ((select sub_profit_centre_code||' - '||sub_profit_centre from sub_profit_centre b where b.sub_profit_centre_code = InwardsPolicy.SUB_PROFIT_CENTRE_CODE AND ROWNUM = 1)) AS VIEW_ATTR,         ((select country_code||' - '||country_description from country  where country_code = InwardsPolicy.RISK_COUNTRY_CODE AND ROWNUM = 1)) AS VIEW_ATTR,         (t> 
####<Oct 6, 2026 10:42:46,758 AM AST> <Notice> <StdErr> <RMSAPP24> <TESTManagedServer> <[ACTIVE] ExecuteThread: '22' for queue: 'weblogic.kernel.Default (self-tuning)'> <SNK> <> <00jivphZJqzFw00Fzzw0w00004Zw000HEm> <1791272566758> <[severity-value: 32] [rid: 0:7] [partition-id: 0] [partition-name: DOMAIN] > <BEA-000000> <runc(DATE_TIME_CREATED)) AS CreateDate1,         (trunc(DATE_TIME_UPDATED)) AS UpdateDate1,         ((SELECT USER_ID||' - '||USERNAME FROM USER_DETAIL WHERE USER_ID=InwardsPolicy.USER_CREATED)) AS UserCreatedDesc,         ((SELECT USER_ID||' - '||USERNAME FROM USER_DETAIL WHERE USER_ID=InwardsPolicy.USER_UPDATED)) AS UserUpdatedDesc FROM INWARDS_POLICY InwardsPolicy WHERE ( ( (InwardsPolicy.SEQUENCE_NUMBER = :P_SEQUENCE_NO ) AND (UPPER(InwardsPolicy.CONTRACT_NUMBER) = UPPER(:P_CONTRACT_NO) ) AND (InwardsPolicy.UNDERWRITING_YEAR = :P_UNDERWITING_YEAR ) ) ) ORDER BY CONTRACT_NUMBER,UNDERWRITING_YEAR> 
